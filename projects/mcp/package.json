{
    "name": "@ngx-translate/mcp",
    "version": "0.1.0",
    "description": "Read-only MCP tools for auditing ngx-translate JSON catalogues",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ngx-translate/core.git",
        "directory": "projects/mcp"
    },
    "bin": {
        "ngx-translate-mcp": "dist/cli.js"
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "lint": "eslint src && prettier --check .",
        "test": "pnpm run build && node --test test/*.test.mjs",
        "prepack": "pnpm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "2.3.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.3.1",
        "@types/node": "^22.0.0"
    }
}
