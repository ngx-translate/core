{
    "name": "my-workspace",
    "version": "1.0.0-rc.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "build-all": "ng build ngx-translate && ng build http-loader",
        "watch": "ng build --watch --configuration development",
        "test": "ng test ngx-translate --code-coverage",
        "test-ci": "ng test ngx-translate --watch=false --browsers=ChromeHeadless && ng test http-loader --watch=false --browsers=ChromeHeadless",
        "coverage": "ng test ngx-translate --code-coverage --watch=false --browsers=ChromeHeadless",
        "lint": "ng lint",
        "format": "prettier --write .",
        "prepare": "husky install"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^22.2.3",
        "@angular/compiler": "^22.2.3",
        "@angular/core": "^22.2.3",
        "@angular/forms": "^22.2.3",
        "@angular/platform-browser": "^22.2.3",
        "@angular/router": "^22.2.3",
        "rxjs": "7.8.2",
        "tslib": "2.8.1",
        "zone.js": "~0.16.3"
    },
    "devDependencies": {
        "@angular/build": "^22.2.3",
        "@angular/cli": "^22.2.3",
        "@angular/compiler-cli": "^22.2.3",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@eslint/js": "10.0.1",
        "@types/jasmine": "6.0.0",
        "angular-eslint": "^22.6.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "husky": "9.1.7",
        "istanbul-lib-instrument": "^6.0.3",
        "jasmine-core": "5.13.0",
        "karma": "6.4.4",
        "karma-chrome-launcher": "3.2.0",
        "karma-coverage": "2.2.1",
        "karma-jasmine": "5.1.0",
        "karma-jasmine-html-reporter": "2.3.0",
        "karma-mocha-reporter": "2.2.5",
        "lint-staged": "16.4.0",
        "ng-packagr": "^22.2.4",
        "prettier": "3.9.10",
        "ts-mocks": "3.0.1",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.72.0"
    },
    "packageManager": "pnpm@12.14.0",
    "lint-staged": {
        "*.js": "eslint --cache --fix",
        "*.{js,css,md}": "prettier --write"
    }
}
