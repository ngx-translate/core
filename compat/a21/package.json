{
    "name": "my-workspace",
    "version": "1.0.0-rc.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "build-all": "ng build ngx-translate && ng build http-loader",
        "watch": "ng build --watch --configuration development",
        "test": "ng test ngx-translate --coverage",
        "test-ci": "ng test ngx-translate --watch=false && ng test http-loader --watch=false",
        "coverage": "ng test ngx-translate --coverage --watch=false",
        "lint": "ng lint",
        "format": "prettier --write .",
        "prepare": "husky install"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^21",
        "@angular/compiler": "^21",
        "@angular/core": "^21",
        "@angular/forms": "^21",
        "@angular/platform-browser": "^21",
        "@angular/router": "^21",
        "rxjs": "7.8.2",
        "tslib": "2.8.1",
        "zone.js": "0.15.1"
    },
    "devDependencies": {
        "@angular/build": "^21",
        "@angular/cli": "^21",
        "@angular/compiler-cli": "^21",
        "@commitlint/cli": "20.1.0",
        "@commitlint/config-conventional": "20.0.0",
        "@vitest/coverage-v8": "4.1.12",
        "angular-eslint": "^21",
        "eslint": "9.39.1",
        "eslint-config-prettier": "10.1.8",
        "husky": "9.1.7",
        "jsdom": "26.1.0",
        "lint-staged": "16.2.6",
        "ng-packagr": "^21",
        "prettier": "3.6.2",
        "ts-mocks": "3.0.1",
        "typescript": "~5.9.0",
        "typescript-eslint": "8.46.4",
        "vitest": "4.1.12"
    },
    "packageManager": "pnpm@12.14.0",
    "lint-staged": {
        "*.js": "eslint --cache --fix",
        "*.{js,css,md}": "prettier --write"
    }
}
